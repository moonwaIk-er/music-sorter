{
  "main": "electron-main.js",
  "name": "music-sorter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "dev": "next dev",
  "electron": "electron .",
  "backend": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn main:app --reload",
  "desktop": "concurrently \"npm run backend\" \"npm run dev\" \"wait-on http://localhost:3000 http://localhost:8000 && npm run electron\"",
  "build": "next build",
  "start": "next start",
  "lint": "eslint",
  "dist": "npm run build && electron-builder --win"
},
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ayah.musicsorter",
    "productName": "Music Sorter",
    "files": [
      "electron-main.js",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/music-backend.exe",
        "to": "backend/dist/music-backend.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
